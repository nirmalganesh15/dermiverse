# Copy to backend/.env and fill in. Never commit the real .env.

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# True only on a developer machine
DEBUG=False

# Hostnames/IPs the clinic PCs use to open the app (server PC name and LAN IP)
ALLOWED_HOSTS=localhost,127.0.0.1,clinic-server,192.168.1.10

# Local development uses SQLite automatically when this is not set.
# Clinic / cloud: PostgreSQL
# DATABASE_URL=postgres://dermverse:password@localhost:5432/dermverse

# Where uploaded files (signature/stamp) are stored
# MEDIA_ROOT=D:/Dermiverse/data/media

TIME_ZONE=Asia/Kolkata
